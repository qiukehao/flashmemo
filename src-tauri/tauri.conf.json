{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashMemo",
  "version": "0.1.0",
  "identifier": "com.flashmemo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "闪记",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "popup",
        "title": "闪记",
        "url": "index.html",
        "visible": false,
        "width": 760,
        "height": 680,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 560,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "http://localhost:1420"
        ],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
